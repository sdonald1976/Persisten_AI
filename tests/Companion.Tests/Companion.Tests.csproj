<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.18" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.18" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.18" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.18" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reference tokenizations generated by Hugging Face, so the hand-written byte-level BPE can
         be checked against them rather than trusted. -->
    <Content Include="Fixtures\data\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Companion.Core\Companion.Core.csproj" />
    <ProjectReference Include="..\..\src\Companion.Infrastructure\Companion.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Companion.Api\Companion.Api.csproj" />
    <ProjectReference Include="..\..\tools\Companion.Eval\Companion.Eval.csproj" />
    <!-- The renderer's model-facing serialization and gate suite are frozen inputs to
         the QLoRA experiment (training/renderer/dataset/freeze.py). Linking the source
         lets the tests pin their behavior. -->
    <Compile Include="..\..\tools\Companion.RendererBench\PlanSerialization.cs" Link="Renderer\PlanSerialization.cs" />
    <Compile Include="..\..\tools\Companion.RendererBench\RendererChecks.cs" Link="Renderer\RendererChecks.cs" />
  </ItemGroup>
</Project>
