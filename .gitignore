# .NET build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user

# SQLite local stores
*.db
*.db-shm
*.db-wal
*.sqlite
*.db.bak-*

# Local API token (generated on first startup)
.companion-api-token

# IDE
.vs/
.idea/
.vscode/

# Secrets / local config
*.env
appsettings.*.local.json
# Machine-local overrides: her world's address and token live here. Loaded in every environment.
appsettings.local.json

# OS
.DS_Store
Thumbs.db

# VRoid Studio project files (the editable .vroid save is not a loadable model — export .vrm instead)
*.vroid

# Runtime prompt overrides (user's local wording, editable via /prompts.html)
prompts/

# Specialist model weights. Fetched by tools/get-models.ps1, never committed: tens to hundreds of
# megabytes, versioned independently of this code, and awkward to remove from history later.
models/
*.onnx

# ...but `models/` above matches ANY directory of that name, including the C# SOURCE directory
# src/Companion.Infrastructure/Models. New files added there were silently untracked - a commit
# would simply not contain them, with nothing to say so. Re-include the source tree explicitly.
!src/Companion.Infrastructure/Models/
!src/Companion.Infrastructure/Models/**

# Python virtualenv for training/ (torch is ~2.5 GB; never committed)
.venv/

# Generated corpora and evaluation artifacts - large, and either reproducible from a recorded command or machine-local experimental records. See docs/SYNTHETIC_LIFE.md.
artifacts/

# Merged/quantized renderer artifacts: multi-GB build outputs, rebuildable from the
# adapter in training/renderer/runs/. LFS refuses files over 2 GB and they do not
# belong in history regardless.
training/renderer/merged/
training/renderer/*.log
