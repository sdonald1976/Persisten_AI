{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Companion": "Warning"
    }
  },
  "Database": {
    "Path": "companion.db"
  },
  "Models": {
    "//": "Provider: 'Mock' (offline default) | 'OpenAiCompatible' (Ollama or LM Studio).",
    "//ollama": "Ollama base URL http://localhost:11434/v1",
    "//lmstudio": "LM Studio base URL http://localhost:1234/v1",
    "//roles": "Each job can use its own model. Extraction/Summarizer are optional and fall back to Chat.",
    "//vision": "Optional: add a 'Vision' block (e.g. Model 'llama3.2-vision') to enable /image.",
    "//transcription": "Optional: add a 'Transcription' block pointing at a Whisper server to enable /transcribe.",
    "Provider": "OpenAiCompatible",
    "Chat": {
      "BaseUrl": "http://localhost:11434/v1",
      "Model": "huihui_ai/dolphin3-abliterated",
      "ApiKey": "",
      "TimeoutSeconds": 300
    },
    "Extraction": {
      "BaseUrl": "http://localhost:11434/v1",
      "Model": "llama3.1:8b",
      "TimeoutSeconds": 180
    },
    "Summarizer": {
      "BaseUrl": "http://localhost:11434/v1",
      "Model": "llama3.2:3b",
      "TimeoutSeconds": 120
    },
    "Embeddings": {
      "BaseUrl": "http://localhost:11434/v1",
      "Model": "nomic-embed-text",
      "ApiKey": "",
      "Dimensions": 768,
      "TimeoutSeconds": 120
    },
    "Vision": {
      "BaseUrl": "http://localhost:11434/v1",
      "Model": "llama3.2-vision"
    },
    "Transcription": {
      "BaseUrl": "http://localhost:8000/v1",
      "Model": "Systran/faster-whisper-small"
    }
  },
  "Companion": {
    "TopK": 6,
    "MemoryTokenBudget": 800,
    "RecentMessageCount": 6,
    "RecencyHalfLifeDays": 45.0,
    "MinScore": 0.05,
    "Weights": {
      "SemanticSimilarity": 1.0,
      "KeywordOverlap": 0.6,
      "Recency": 0.3,
      "Importance": 0.3,
      "Confidence": 0.2,
      "ProjectAssociation": 0.5,
      "OpenLoopBoost": 0.4
    }
  }
}
