{
  "Urls": "http://localhost:5266",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Companion": "Warning"
    }
  },
  "Database": {
    "Path": "companion.db"
  },
  "Api": {
    "//": "Local API security. Binds to loopback by default; CORS is an explicit allow-list.",
    "//auth": "AuthEnabled true requires a token (Authorization: Bearer, X-Companion-Key, or ?access_token=).",
    "//token": "Leave Token empty to auto-generate one on first startup (saved to .companion-api-token next to the DB).",
    "AuthEnabled": false,
    "Token": "",
    "AllowedOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173" ]
  },
  "Models": {
    "//": "Provider: 'Mock' (offline default) | 'OpenAiCompatible' (Ollama or LM Studio).",
    "//ollama": "Ollama base URL http://localhost:11434/v1",
    "//lmstudio": "LM Studio base URL http://localhost:1234/v1",
    "//roles": "Each job can use its own model. Extraction/Summarizer are optional and fall back to Chat.",
    "//vision": "Optional: add a 'Vision' block (e.g. Model 'llama3.2-vision') to enable /image.",
    "//transcription": "Optional: add a 'Transcription' block pointing at a Whisper server to enable /transcribe.",
    "Provider": "OpenAiCompatible",
    "Chat": {
      "BaseUrl": "http://localhost:11434/v1",
      "Model": "huihui_ai/dolphin3-abliterated",
      "ApiKey": "",
      "Temperature": 0.6,
      "FrequencyPenalty": 0.6,
      "PresencePenalty": 0.3,
      "TimeoutSeconds": 300
    },
    "Extraction": {
      "BaseUrl": "http://localhost:11434/v1",
      "Model": "llama3.1:8b",
      "Temperature": 0.2,
      "TimeoutSeconds": 180
    },
    "Summarizer": {
      "BaseUrl": "http://localhost:11434/v1",
      "Model": "llama3.2:3b",
      "Temperature": 0.3,
      "TimeoutSeconds": 120
    },
    "Embeddings": {
      "BaseUrl": "http://localhost:11434/v1",
      "Model": "nomic-embed-text",
      "ApiKey": "",
      "Dimensions": 768,
      "TimeoutSeconds": 120
    },
    "Vision": {
      "BaseUrl": "http://localhost:11434/v1",
      "Model": "llama3.2-vision"
    },
    "Transcription": {
      "BaseUrl": "http://localhost:8000/v1",
      "Model": "Systran/faster-whisper-small"
    }
  }
}
