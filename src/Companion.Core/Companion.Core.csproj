<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Companion.Core is pure: domain records, interfaces, and logic only.
    It intentionally has NO dependency on EF Core or any model-provider SDK.
    Those live in Companion.Infrastructure behind the interfaces declared here.
    The two Extensions.* references are lightweight abstractions (logging + options),
    not concrete implementations, so they don't couple Core to any vendor.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>
</Project>
