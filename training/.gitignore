# Never commit personal training data or model artifacts.
data/
outputs/
*.jsonl
*.gguf
.venv/

# Exception: the renderer corpus is authored specimens and synthetic scenarios, not
# harvested conversation. It MUST be versioned — the benchmark fixtures are what every
# result is measured against, and freeze.py hashes the dataset so that "no changing
# examples after approval" can be checked rather than promised. A file that exists on
# one machine cannot be frozen.
!renderer/fixtures.jsonl
!renderer/dataset/scenarios/*.jsonl
!renderer/dataset/candidates*.jsonl
!renderer/dataset/train-*.jsonl
!renderer/dataset/plan2-current.jsonl
!renderer/dataset/curation-*.jsonl
!renderer/unseen/*.jsonl
!renderer/unseen-plan2.jsonl
!renderer/run1a-training-log.txt

# Python bytecode from the training scripts
__pycache__/
*.pyc

# Generated by training/supersession/assemble.py; regenerated per machine, never committed
*.manifest.json

# Run-1a training machinery: the dedicated CUDA venv, the downloaded base model, and
# training outputs (checkpoints/adapters). The freeze manifest records their hashes
# and the base-model revision pin; the artifacts themselves stay machine-local.
.venv-train/
renderer/models/
renderer/runs/

# Exception: the trained adapters themselves. 130MB each, but they ARE the experiment's
# product — a result that exists on one machine is one disk failure from never having
# happened. Checkpoints stay local; the final adapters travel with the repo.
!renderer/runs/
renderer/runs/*/checkpoint-*/
renderer/runs/*/*.jsonl
renderer/runs/*/*.log
renderer/runs/*/*.txt
renderer/runs/*/*.md
!renderer/runs/run-1a/adapter-final/
!renderer/runs/run-1b/adapter-final/
!renderer/runs/run-1c/adapter-final/
