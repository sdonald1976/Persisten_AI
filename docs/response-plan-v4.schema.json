{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://persisten-ai/response-plan-v4.schema.json",
  "title": "ResponsePlan v4 wire contract",
  "description": "plan/4 is plan/3 plus an OPTIONAL `frame`. A plan with no frame is an ordinary real turn, serializes no FRAME section, and costs zero frame tokens \u2014 which is why one protocol carries both real and fiction turns. plan/3 remains frozen as historical shadow evidence; this is a sibling document and never an edit to it. The frame changes how the rest of the plan is READ and never what is true: fictional content never becomes a claim about the real person, and characterIds are frame-local and may never authorize anything. There is deliberately NO content classification here \u2014 no rating, contentClass or intensity \u2014 because sexual content, profanity, romance, darkness and violence are ordinary possible fictional content; a restriction exists only when an explicit user boundary or explicit hosting configuration backs it. Everything else is as plan/3, including additionalProperties:false throughout.",
  "type": "object",
  "required": [
    "protocol",
    "minorVersion",
    "traceId",
    "participants",
    "act",
    "question",
    "items",
    "register"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "plan/4"
    },
    "minorVersion": {
      "type": "integer",
      "minimum": 0
    },
    "traceId": {
      "type": "string",
      "format": "uuid"
    },
    "participants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "display"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "STABLE authorization identifier; uniqueness app-validated"
          },
          "role": {
            "enum": [
              "user",
              "companion",
              "other"
            ]
          },
          "display": {
            "type": "string",
            "description": "presentation label ONLY \u00e2\u20ac\u201d never used for authorization"
          }
        }
      }
    },
    "act": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "question": {
      "type": "object",
      "required": [
        "policy"
      ],
      "additionalProperties": false,
      "properties": {
        "policy": {
          "enum": [
            "ask_required",
            "may_ask",
            "question_forbidden"
          ],
          "description": "the SOLE authority over question prohibition (no item-level duplicate exists)"
        },
        "itemId": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "policy": {
                "const": "ask_required"
              }
            }
          },
          "then": {
            "required": [
              "itemId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "policy": {
                "const": "question_forbidden"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "itemId"
              ]
            }
          }
        }
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/planItem"
      }
    },
    "register": {
      "$ref": "#/$defs/register"
    },
    "registerRestrictions": {
      "type": "array",
      "description": "Every restrictive register value must be owned here. dimension is CLOSED (the nine register dimensions) and value must be legal for it (app-validated). reasonCode families: user-preference.*, privacy-audience.*, tool-authorization.*, epistemic-integrity.*, hosting-config.*. user-preference.* and hosting-config.* REQUIRE provenance.evidenceRef \u00e2\u20ac\u201d authority cannot merely be claimed.",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "value",
          "owner",
          "reasonCode"
        ],
        "additionalProperties": false,
        "properties": {
          "dimension": {
            "enum": [
              "warmth",
              "bluntness",
              "playfulness",
              "teasing",
              "skepticism",
              "intensity",
              "verbosity",
              "profanity",
              "mirror"
            ]
          },
          "value": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "reasonCode": {
            "$ref": "#/$defs/reasonCode"
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxItems": {
          "type": "integer",
          "minimum": 1
        },
        "dropOrder": {
          "type": "array",
          "items": {
            "enum": [
              "background_only",
              "may_express",
              "style_detail"
            ]
          },
          "description": "CLOSED; obligations are absent by construction. A budget below the undroppable obligations is a DIAGNOSED invalid plan, never a license to drop."
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "frame": {
      "$ref": "#/$defs/frame"
    }
  },
  "$defs": {
    "reasonCode": {
      "type": "string",
      "pattern": "^(user-preference|privacy-audience|tool-authorization|epistemic-integrity|hosting-config)\\.[a-z0-9-]+$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "evidenceRef": {
          "type": "string"
        }
      }
    },
    "planItem": {
      "type": "object",
      "required": [
        "id",
        "type",
        "policy",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "type": {
          "type": "string",
          "description": "OPEN semantic type \u00e2\u20ac\u201d diagnostics/attribution only, NEVER model-facing",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "category": {
          "enum": [
            "claim",
            "memory",
            "shared_memory",
            "knowledge",
            "correction",
            "agreement",
            "teaching",
            "answer",
            "clarify",
            "curiosity",
            "boundary",
            "superseded",
            "state",
            "observation",
            "note"
          ],
          "description": "CLOSED model-facing label (rendered kebab-case in CompactV3); absent = derived from policy"
        },
        "policy": {
          "enum": [
            "must_express",
            "may_express",
            "background_only",
            "must_not_express",
            "admit_unknown",
            "ask_required"
          ],
          "description": "CLOSED, SIX values \u00e2\u20ac\u201d question prohibition lives in question.policy and style in register, with no item-level duplicates. Unknown value \u00e2\u2021\u2019 WHOLE plan invalid."
        },
        "text": {
          "type": "string"
        },
        "quoted": {
          "type": "boolean",
          "default": false
        },
        "value": {
          "description": "structured value when text is lossy"
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "classification": {
          "enum": [
            "public",
            "personal",
            "private",
            "intimate"
          ],
          "default": "personal"
        },
        "disclosure": {
          "enum": [
            "unrestricted",
            "participants",
            "restricted"
          ],
          "default": "participants",
          "description": "restricted REQUIRES an explicit audience (app-validated)"
        },
        "owner": {
          "type": "string",
          "description": "whose information this is: an in-plan participant id or a scheme-prefixed principal ref (principal:\u00e2\u20ac\u00a6). Information about a third party is not owned by its supplier."
        },
        "audience": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "authorized audience: in-plan participant ids or scheme-prefixed principal refs; display names never authorize"
        },
        "retention": {
          "enum": [
            "full",
            "no_training",
            "no_telemetry_text",
            "volatile_turn_only"
          ],
          "default": "full",
          "description": "independent of expression; see spec \u00c2\u00a72.6 for the volatile_turn_only surface matrix"
        },
        "reasonCode": {
          "$ref": "#/$defs/reasonCode"
        },
        "validity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string",
              "format": "date-time"
            },
            "until": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supersededBy": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        },
        "checkTokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "policy": {
                "const": "must_not_express"
              }
            }
          },
          "then": {
            "required": [
              "reasonCode"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "disclosure": {
                "const": "restricted"
              }
            }
          },
          "then": {
            "required": [
              "audience"
            ]
          }
        }
      ]
    },
    "register": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "warmth": {
          "enum": [
            "cold",
            "cool",
            "plain",
            "warm",
            "tender"
          ]
        },
        "bluntness": {
          "enum": [
            "soft",
            "plain",
            "blunt"
          ]
        },
        "playfulness": {
          "enum": [
            "off",
            "light",
            "full"
          ]
        },
        "teasing": {
          "enum": [
            "off",
            "allowed",
            "invited"
          ]
        },
        "skepticism": {
          "enum": [
            "off",
            "open",
            "on"
          ]
        },
        "intensity": {
          "enum": [
            "flat",
            "even",
            "raised"
          ]
        },
        "verbosity": {
          "enum": [
            "terse",
            "short",
            "conversational",
            "expansive"
          ]
        },
        "profanity": {
          "enum": [
            "unrestricted",
            "mirror-only",
            "encouraged",
            "neutral",
            "avoid",
            "forbidden"
          ]
        },
        "mirror": {
          "type": "boolean"
        },
        "legacyStyle": {
          "type": "string",
          "description": "MIGRATION METADATA ONLY: v2 tone prose for lossless round-trips; never enters CompactV3 (tested)"
        }
      }
    },
    "frameCharacter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characterId",
        "display"
      ],
      "properties": {
        "characterId": {
          "type": "string",
          "minLength": 1,
          "description": "Frame-local. NEVER a principal: may not appear in any audience, owner, or recipient set."
        },
        "display": {
          "type": "string",
          "minLength": 1
        },
        "controlledBy": {
          "type": [
            "string",
            "null"
          ],
          "description": "A participant id, or null for an unvoiced NPC. MAY REPEAT: one participant can control several characters."
        }
      }
    },
    "frameNarrator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "character",
            "external"
          ]
        },
        "characterId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Required when kind=character; must be absent/null when kind=external."
        },
        "viewpointCharacterId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Whose perspective. Separate from the narrator so third-person limited is expressible."
        },
        "person": {
          "enum": [
            "first",
            "second",
            "third"
          ]
        }
      }
    },
    "frameBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundaryId",
        "subject",
        "evidenceRef"
      ],
      "properties": {
        "boundaryId": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "description": "What the user asked for, as stated. Named on the wire so the mouth can obey it."
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1,
          "description": "FrameBoundaryRecord.Id. REQUIRED \u2014 a stated restriction with nothing behind it is unowned authority."
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "transition"
      ],
      "properties": {
        "mode": {
          "enum": [
            "real",
            "fiction"
          ],
          "description": "real is legal ONLY with transition=exit."
        },
        "transition": {
          "enum": [
            "enter",
            "continue",
            "switch",
            "exit"
          ]
        },
        "sceneRef": {
          "type": [
            "string",
            "null"
          ],
          "description": "Scene IDENTITY, not a store. Required for continue/switch. Cannot retrieve prior scene content \u2014 continuity is transcript-window continuity."
        },
        "narration": {
          "enum": [
            "forbidden",
            "licensed"
          ]
        },
        "continuity": {
          "enum": [
            "none",
            "maintain"
          ]
        },
        "activeCompanionCharacterId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Explicit. Absent means the companion is narrating rather than voicing a character. Never derived from controlledBy uniqueness."
        },
        "narrator": {
          "$ref": "#/$defs/frameNarrator"
        },
        "characters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frameCharacter"
          }
        },
        "boundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frameBoundary"
          }
        }
      }
    }
  }
}